# Server
NODE_ENV=development
PORT=3001

# Python demo pipeline API (extra-backend / FastAPI). Default: http://127.0.0.1:8000
EXTRA_BACKEND_URL=http://127.0.0.1:8000

# FaceIT Open API (https://developers.faceit.com/)
FACEIT_KEY=

# Outbound GET to open.faceit.com (ms), default 20000
FACEIT_HTTP_TIMEOUT_MS=20000

# Optional: same value as frontend / extra-backend (documented for ops alignment).
# Express only *forwards* X-Internal-Token from the Next.js BFF; it does not inject this secret.
INTERNAL_API_SECRET=

# Rate limiting (backup if Express is publicly reachable). Default: enabled.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_FACEIT_LIMIT=120
# RATE_LIMIT_ANALYTICS_LIMIT=60
# RATE_LIMIT_FACEIT_WINDOW_MS=60000
# RATE_LIMIT_ANALYTICS_WINDOW_MS=60000
