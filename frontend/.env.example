# Frontend (Next.js) — copy to `.env.local`

# Public site / Steam OpenID
# STEAM_API_KEY from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# MongoDB for users / profile views
MONGODB_URI=mongodb://127.0.0.1:27017/csgrind

# Express API (FACEIT proxy + /v1 → extra-backend)
BACKEND_URL=http://localhost:5000

# Optional: outbound timeout to Express (ms)
# BACKEND_FETCH_TIMEOUT_MS=25000

# Leetify API
LEETIFY_KEY=

# Signed Steam session cookie (iron-session). Min 32 characters.
# Required in production. Generate e.g.: openssl rand -base64 32
SESSION_SECRET=

# Same value as extra-backend INTERNAL_API_SECRET.
# Injected server-side on /api/v1 and Valve/archive BFF calls. Never expose to the browser.
INTERNAL_API_SECRET=

# Rate limiting (in-memory per Next.js process). Default: enabled.
RATE_LIMIT_ENABLED=true
# Optional per-bucket overrides (requests per window):
# RATE_LIMIT_STEAM_LIMIT=30
# RATE_LIMIT_FACEIT_LIMIT=60
# RATE_LIMIT_LEETIFY_LIMIT=40
# RATE_LIMIT_ANALYTICS_LIMIT=30
# RATE_LIMIT_VALVE_WRITE_LIMIT=5
# RATE_LIMIT_STEAM_WINDOW_MS=60000
