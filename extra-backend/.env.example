# HTTP API
HOST=0.0.0.0
PORT=8000

# FACEIT Data API (https://developers.faceit.com/) — used for players, matches, history
FACEIT_KEY=

# Downloads API ONLY — not the same as FACEIT_KEY. Apply: https://fce.gg/downloads-api-application
# Docs: https://docs.faceit.com/getting-started/Guides/download-api/
# Must be plain ASCII (no Unicode lookalikes in the string).
FACEIT_DOWNLOAD_TOKEN=

# Optional override (default: https://open.faceit.com)
FACEIT_API_BASE=https://open.faceit.com
FACEIT_DOWNLOAD_API_BASE=https://open.faceit.com

# Storage
DATABASE_URL=sqlite:///./data/csgrind_demos.db
DEMOS_DIR=./data/demos
# Delete local demo files older than N days (0 = keep forever). Default 14. Analytics stay in DB.
DEMO_RETENTION_DAYS=14

# Parallel demo pipeline inside the background refresh (default 4; set 1 to force sequential)
MATCH_PIPELINE_MAX_WORKERS=4

# Celery / Redis — required for the non-blocking GET /v1/analytics/by-steam refresh.
# Run a worker (see below) OR set CELERY_EAGER=true to run the refresh inline without a broker
# (inline = the endpoint becomes blocking again, but needs no Redis).
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=false

# Proactive demo archival when a profile is viewed (POST /v1/analytics/archive/by-steam/...)
ARCHIVE_SCAN_RECENT=3
ARCHIVE_DEDUPE_HOURS=6

# Valve MM match history (GetNextMatchSharingCode) — same key as frontend STEAM_API_KEY
STEAM_API_KEY=

# Encrypt stored Valve auth codes at rest (any long random string)
VALVE_CODES_SECRET=

# Shared secret for Next.js / Express → this API (header: X-Internal-Token).
# Required when ENVIRONMENT=production. Protects Valve link, sync, process, archive, refresh, etc.
INTERNAL_API_SECRET=

# development | production — production refuses protected routes if INTERNAL_API_SECRET is empty
ENVIRONMENT=development

# How many MM share codes to walk per sync (default 8)
VALVE_SYNC_MAX_MATCHES=8

# Run API from extra-backend/ (use the same Python that has deps installed):
#   .\.venv\Scripts\python -m uvicorn app.main:app --reload --port 8000
# Or after: python -m pip install -r requirements.txt
#   python -m uvicorn app.main:app --reload --port 8000
# Worker: celery -A run_celery:app worker --loglevel=info
# Windows worker: celery -A run_celery:app worker --pool=solo --loglevel=info
